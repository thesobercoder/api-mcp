{
  "apis": [
    {
      "name": "trakt",
      "headers": {
        "trakt-api-key": {
          "env": "TRAKT_CLIENT_ID"
        },
        "trakt-api-version": "2"
      },
      "forwardHeaders": [
        "authorization"
      ],
      "wrapResponse": true,
      "responseHeadersKey": "pagination",
      "responseHeaders": {
        "page": "x-pagination-page",
        "pages": "x-pagination-page-count",
        "limit": "x-pagination-limit",
        "total": "x-pagination-item-count"
      },
      "instructions": "Paginate before claiming complete history or lists. The account is managed by Bifrost.",
      "spec": {
        "openapi": "3.0.3",
        "info": {
          "title": "Trakt account API",
          "version": "1"
        },
        "servers": [
          {
            "url": "https://api.trakt.tv"
          }
        ],
        "components": {
          "securitySchemes": {
            "traktKey": {
              "type": "apiKey",
              "in": "header",
              "name": "trakt-api-key"
            },
            "account": {
              "type": "http",
              "scheme": "bearer"
            }
          }
        },
        "security": [
          {
            "traktKey": [],
            "account": []
          }
        ],
        "paths": {
          "/users/settings": {
            "get": {
              "operationId": "profile",
              "description": "Read the connected Trakt account settings.",
              "parameters": [],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/sync/history/{type}": {
            "get": {
              "operationId": "history",
              "description": "Read watched movies/episodes, newest first. Follow pagination for complete history.",
              "parameters": [
                {
                  "name": "page",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "default": 1
                  }
                },
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  }
                },
                {
                  "name": "type",
                  "in": "path",
                  "schema": {
                    "type": "string",
                    "enum": [
                      "all",
                      "movies",
                      "episodes"
                    ],
                    "default": "all"
                  },
                  "required": true,
                  "x-mcp-omit-path-values": [
                    "all"
                  ]
                },
                {
                  "name": "start_at",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "end_at",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/sync/watchlist/{type}": {
            "get": {
              "operationId": "watchlist",
              "description": "Read your watchlist, with pagination.",
              "parameters": [
                {
                  "name": "page",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "default": 1
                  }
                },
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  }
                },
                {
                  "name": "type",
                  "in": "path",
                  "schema": {
                    "type": "string",
                    "enum": [
                      "all",
                      "movies",
                      "shows",
                      "seasons",
                      "episodes"
                    ],
                    "default": "all"
                  },
                  "required": true
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/sync/ratings/{type}": {
            "get": {
              "operationId": "ratings",
              "description": "Read your ratings, with pagination.",
              "parameters": [
                {
                  "name": "page",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "default": 1
                  }
                },
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  }
                },
                {
                  "name": "type",
                  "in": "path",
                  "schema": {
                    "type": "string",
                    "enum": [
                      "all",
                      "movies",
                      "shows",
                      "seasons",
                      "episodes"
                    ],
                    "default": "all"
                  },
                  "required": true
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/search/{type}": {
            "get": {
              "operationId": "search",
              "description": "Search public movie/show titles and IDs.",
              "parameters": [
                {
                  "name": "page",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "default": 1
                  }
                },
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  }
                },
                {
                  "name": "query",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "minLength": 1
                  },
                  "required": true
                },
                {
                  "name": "type",
                  "in": "path",
                  "schema": {
                    "type": "string",
                    "enum": [
                      "movie",
                      "show",
                      "movie,show"
                    ],
                    "default": "movie,show"
                  },
                  "required": true
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              },
              "security": [
                {
                  "traktKey": []
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "whoop",
      "forwardHeaders": [
        "authorization"
      ],
      "instructions": "Live WHOOP API data. Paginate using nextToken. This does not read Executor stored history. The account is managed by Bifrost.",
      "spec": {
        "openapi": "3.0.3",
        "info": {
          "title": "WHOOP live account API",
          "version": "2"
        },
        "servers": [
          {
            "url": "https://api.prod.whoop.com/developer"
          }
        ],
        "components": {
          "securitySchemes": {
            "account": {
              "type": "http",
              "scheme": "bearer"
            }
          }
        },
        "security": [
          {
            "account": []
          }
        ],
        "paths": {
          "/v2/user/profile/basic": {
            "get": {
              "operationId": "profile",
              "description": "Read your live WHOOP basic profile.",
              "parameters": [],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/v2/user/measurement/body": {
            "get": {
              "operationId": "body_measurements",
              "description": "Read your live body measurements.",
              "parameters": [],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/v2/cycle": {
            "get": {
              "operationId": "cycles",
              "description": "Read a page of live cycles. Follow next_token for additional pages.",
              "parameters": [
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25,
                    "default": 25
                  }
                },
                {
                  "name": "start",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "end",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "nextToken",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/v2/recovery": {
            "get": {
              "operationId": "recovery",
              "description": "Read a page of live recovery. Follow next_token for additional pages.",
              "parameters": [
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25,
                    "default": 25
                  }
                },
                {
                  "name": "start",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "end",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "nextToken",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/v2/activity/sleep": {
            "get": {
              "operationId": "sleep",
              "description": "Read a page of live sleep. Follow next_token for additional pages.",
              "parameters": [
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25,
                    "default": 25
                  }
                },
                {
                  "name": "start",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "end",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "nextToken",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          },
          "/v2/activity/workout": {
            "get": {
              "operationId": "workouts",
              "description": "Read a page of live workouts. Follow next_token for additional pages.",
              "parameters": [
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25,
                    "default": 25
                  }
                },
                {
                  "name": "start",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "end",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512,
                    "format": "date-time"
                  }
                },
                {
                  "name": "nextToken",
                  "in": "query",
                  "schema": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "API response"
                }
              }
            }
          }
        }
      }
    }
  ]
}
